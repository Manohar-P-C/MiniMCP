# MiniMCP environment configuration
# Copy this file to .env and fill in your own values.
# Never commit real secrets or authentication tokens to version control.

# Server identification
MINIMCP_SERVER_NAME=MiniMCP
MINIMCP_SERVER_VERSION=1.0.0
MINIMCP_PROTOCOL_VERSION=2025-03-26

# Bearer token protecting the /mcp endpoint. Generate a strong random value,
# e.g. python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to disable authentication (not recommended for production).
MINIMCP_AUTH_TOKEN=your-secure-bearer-token-here

# Comma separated list of allowed CORS origins. "*" allows all origins.
MINIMCP_CORS_ORIGINS=*

# Maximum request body size in bytes for the /mcp endpoint (default 1 MB).
MINIMCP_MAX_REQUEST_SIZE=1048576

# Runtime
MINIMCP_DEBUG=false
MINIMCP_LOG_LEVEL=INFO
MINIMCP_HOST=0.0.0.0
MINIMCP_PORT=5000
